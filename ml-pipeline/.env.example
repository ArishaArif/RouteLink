# Copy this file to `.env` and fill in real values.
# `.env` itself is gitignored -- never commit real keys.

# Weather API (for the weather-based scheduling model)
WEATHER_API_KEY=your_openweathermap_key_here

# News scraping (for hazard NLP data collection)
NEWS_API_KEY=your_newsapi_key_here

# Twitter/X API (for real-time hazard signal from social posts)
TWITTER_BEARER_TOKEN=your_twitter_bearer_token_here
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here

# If your AI/ML service is exposed to the Backend teammate as an API
ML_SERVICE_PORT=8000
