# Server
PORT=5000
NODE_ENV=development

# PostgreSQL
# Either set DATABASE_URL, or the discrete DB_* vars below (DATABASE_URL wins).
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/Routelink
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Routelink
DB_USER=postgres
DB_PASSWORD=your_password

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
