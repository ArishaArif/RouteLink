PORT=5000
NODE_ENV=development


DB_HOST=localhost
DB_PORT=5432
DB_NAME=Routelink
DB_USER=postgres
DB_PASSWORD=your_password

JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d


ML_SERVICE_KEY=replace_with_a_long_random_string
HAZARD_INGEST_KEY=replace_with_a_different_long_random_string


RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
HAZARD_RATE_LIMIT_MAX=60
RATE_LIMIT_DISABLED=false


ITINERARY_ML_MOCK=false


ML_SERVICE_URL=
ML_SERVICE_TIMEOUT_MS=4000


TRUST_PROXY=
CORS_ORIGINS=


# n8n chatbot webhook — production URL of your n8n Cloud webhook trigger
# Do NOT use the /webhook-test/ URL — that only works from the n8n editor
N8N_WEBHOOK_URL=
N8N_WEBHOOK_KEY=
N8N_WEBHOOK_TIMEOUT_MS=30000
