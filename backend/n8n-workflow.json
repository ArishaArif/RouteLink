{
  "name": "RouteLink Chatbot",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "routelink-chatbot",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1b2c3d4-0001-4000-a000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 300],
      "webhookId": "routelink-chatbot",
      "credentials": {
        "httpHeaderAuth": {
          "id": "1",
          "name": "RouteLink Chatbot Auth"
        }
      }
    },
    {
      "parameters": {
        "options": {
          "systemMessage": "You are RouteLink's AI travel assistant. Help users plan trips, find local guides, understand hazard alerts, and answer questions about destinations. Be concise, friendly, and practical. Keep replies under 3 sentences unless the user asks for detailed information. You have access to RouteLink's features: trip planning, guide marketplace, hazard alerts, bookings, SOS emergency support, and destination recommendations."
        },
        "promptType": "define",
        "text": "={{ $json.body.message }}",
        "hasOutputParser": false
      },
      "id": "a1b2c3d4-0002-4000-a000-000000000002",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [300, 300]
    },
    {
      "parameters": {
        "model": "gemini-3-flash-preview",
        "options": {}
      },
      "id": "a1b2c3d4-0003-4000-a000-000000000003",
      "name": "Google Gemini Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1.2,
      "position": [220, 520],
      "credentials": {
        "googlePalmApi": {
          "id": "2",
          "name": "Google Gemini API"
        }
      }
    },
    {
      "parameters": {
        "sessionKey": "={{ $('Webhook').item.json.body.sessionId }}",
        "contextWindowLength": 10
      },
      "id": "a1b2c3d4-0004-4000-a000-000000000004",
      "name": "Simple Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [380, 520]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ reply: $json.output, sessionId: $('Webhook').item.json.body.sessionId }) }}",
        "options": {}
      },
      "id": "a1b2c3d4-0005-4000-a000-000000000005",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [600, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "AI Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Agent": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Gemini Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Simple Memory": {
      "ai_memory": [
        [
          {
            "node": "AI Agent",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [],
  "triggerCount": 0,
  "updatedAt": null,
  "versionId": null
}
